{
 "schemaVersion": 1,
 "id": "steam",
 "name": "Steam",
 "category": "app",
 "match": {
  "exeNames": [
   "SteamSetup.exe"
  ],
  "sha256": []
 },
 "engine": {
  "graphics": "dxvk"
 },
 "actions": [
  {
   "type": "download",
   "url": "https://cdn.fastly.steamstatic.com/client/installer/SteamSetup.exe",
   "sha256": "7d3654531c32d941b8cae81c4137fc542172bfa9635f169cb392f245a0a12bcb",
   "destination": "steam-install/SteamSetup.exe"
  },
  {
   "type": "run",
   "path": "steam-install/SteamSetup.exe",
   "arguments": [
    "/S"
   ],
   "skipIfExists": "Program Files (x86)/Steam/steam.exe"
  },
  {
   "type": "wrap",
   "path": "Program Files (x86)/Steam/bin/cef/cef.win64/steamwebhelper.exe",
   "arguments": [
    "--single-process",
    "--disable-gpu",
    "--in-process-gpu"
   ]
  },
  {
   "type": "wrap",
   "path": "Program Files (x86)/Steam/bin/cef/cef.win7x64/steamwebhelper.exe",
   "arguments": [
    "--single-process",
    "--disable-gpu",
    "--in-process-gpu"
   ]
  },
  {
   "type": "wrap",
   "path": "Program Files (x86)/Steam/bin/cef/cef.win7/steamwebhelper.exe",
   "arguments": [
    "--single-process",
    "--disable-gpu",
    "--in-process-gpu"
   ]
  }
 ],
 "launch": {
  "program": "C:\\Program Files (x86)\\Steam\\steam.exe",
  "arguments": [
   "-noverifyfiles",
   "-norepairfiles",
   "-no-cef-sandbox"
  ],
  "shutdown": [
   "-shutdown"
  ]
 },
 "rating": "bronze",
 "notes": "Steam's browser (CEF) paints black windows under Wine on macOS; each helper variant (win64, win7x64, win7) is wrapped to run in single-process software mode. Steam picks a variant itself, so all are covered."
}